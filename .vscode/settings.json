{
  // oxfmt formats on save (config in .oxfmtrc.json); oxlint applies its autofixes
  // on save (config in .oxlintrc.json, type-aware via oxlint-tsgolint).
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never"
  },
  // Language-specific formatter settings in user settings beat the workspace-wide
  // default above, so pin oxfmt per language for everything it formats here.
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[html]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "oxc.requireConfig": true,

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  // Tracks are text grids that can live in template strings; don't touch them.
  "files.trimTrailingWhitespaceInRegexAndStrings": false,

  "[markdown]": {
    "files.trimTrailingWhitespace": false,
    "editor.formatOnSave": false
  },

  "js/ts.preferences.quoteStyle": "single",

  // TypeScript 7 is the native (Go) compiler and ships no tsserver.js, so editor
  // support comes from the TypeScript Native Preview extension, using the repo's copy.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript",

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true
  }
}
