      "moves": [
        2, 5, 7, 5, 5, 5, 5, 4, 3, 6, 6, 6, 6, 6, 1, 0, 0, 0, 0, 1, 2, 2, 5, 5, 6, 6, 6, 8, 8, 8, 6, 0, 0, 0, 0, 2, 2,
        2, 2, 2, 8, 8, 5, 5
